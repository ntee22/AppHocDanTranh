    <string name="tuner_guide_title">How to tune</string>
    <string name="tuner_guide_step1_title">Always listening</string>
    <string name="tuner_guide_step1_body">The app listens by default. Pluck a real string and it detects the pitch.</string>
    <string name="tuner_guide_step2_title">Tighten or loosen</string>
    <string name="tuner_guide_step2_body">Watch the needle: right means sharp (♯ loosen), left means flat (♭ tighten). Centred and green is in tune.</string>
    <string name="tuner_guide_step3_title">Tune one string</string>
    <string name="tuner_guide_step3_body">Tap any string to lock onto it.</string>
    <string name="tuner_guide_step4_title">Back to automatic</string>
    <string name="tuner_guide_step4_body">Tap the selected string again to return to auto-detect.</string>
